# react-day-picker@8 (the version components/ui/calendar.tsx and base_sdk's
# components/ui/date-range-picker.tsx are written against) declares a peer of
# date-fns "^2.28.0 || ^3.0.0", while base_sdk's manifest declares
# date-fns ^4.1.0 — the version the composer injects into package.json on
# every compose. The two are compatible in practice (v4 kept v8's formatting
# API; RokctAI/rokctai_frontend ships the same pair) but npm's strict peer
# resolver refuses the tree. Accept it here rather than pinning a date-fns
# the registry template would overwrite on the next compose.
legacy-peer-deps=true
